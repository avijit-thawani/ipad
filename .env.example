# Server-side only. Nothing here is prefixed VITE_, so nothing reaches the
# browser bundle. Copy to .env for local dev; set the same keys in the Netlify
# dashboard for production.

# The single shared password for the app. This is the only thing standing
# between a stranger and your OpenRouter credits.
APP_PASSWORD=

# Random string used to sign session tokens and hash the password comparison.
# Generate with: openssl rand -base64 32
APP_SECRET=

# https://openrouter.ai/keys — never exposed to the client.
OPENROUTER_API_KEY=

# Optional. Any model from https://openrouter.ai/collections/image-models that
# accepts input_references. Defaults to google/gemini-3.1-flash-image.
IMAGE_MODEL=

# Optional. The tldraw hobby/commercial license key, requested at
# https://tldraw.dev. Client-side validated and domain-restricted, so it is
# safe in the bundle — hence the VITE_ prefix. Only needed in production.
VITE_TLDRAW_LICENSE_KEY=
